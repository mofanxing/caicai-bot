APP_ENV=development
# 本地开发至少 6 位，可改为 123456；生产环境至少 32 位
# 随机令牌可使用 python -c 'import secrets; print(secrets.token_urlsafe(32))' 生成
ADMIN_TOKEN=replace-with-your-random-admin-token-32-chars
DATABASE_URL=sqlite:///./data/caicai.db
# 只用于本地调试，模拟回答会显式带有“模拟回复”前缀
MOCK_LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=45
# 兼容旧站点的可选环境变量；新站点推荐在页面直接填写 API Key，后端加密保存
CAICAI_PROVIDER_KEY=
# 页面 API Key 加密主密钥：开发环境留空时自动生成 data/keys/provider.key（权限 0600）。
# 生产环境必须通过环境变量提供有效的 Fernet 密钥，勿与数据库一起暴露。
PROVIDER_ENCRYPTION_KEY=
PROVIDER_ENCRYPTION_KEY_FILE=./data/keys/provider.key
# 本地语音（Apple Silicon）；安装见 docs/LOCAL_TTS.md，推理不调用云端 TTS
SPEECH_DATA_DIR=./data/tts
LOCAL_TTS_TIMEOUT_SECONDS=600
# 默认自动定位 backend 下的独立环境与模型；只有自定义安装路径时才填写
# LOCAL_TTS_PYTHON=/absolute/path/to/backend/.tts-venv/bin/python
# LOCAL_TTS_MODEL_DIR=/absolute/path/to/backend/data/tts/models/VoxCPM2-4bit
# 私人微信桥接程序尚未实现。以下是预留的自定义桥接协议配置
WECHAT_BRIDGE_URL=
WECHAT_INBOUND_TOKEN=
WECHAT_OUTBOUND_TOKEN=

